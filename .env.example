# Google AdSense
# ─────────────────────────────────────────────────────────
# 1) 발행자 ID (필수)
#    AdSense → 사이트 → "코드 받기" 또는 광고 코드 안의 ca-pub-XXXXXXXX
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX

# 2) 광고 단위 ID (필수)
#    AdSense → 광고 → 광고 단위별 → 디스플레이 광고 → 새 광고 단위 만들기
#    → "반응형" 선택 → 만들기 후 나오는 코드에서:
#
#      data-ad-slot="1234567890"
#                      ^^^^^^^^^^
#                      이 10자리 숫자가 광고 단위 ID입니다.
#
#    하나만 만들어도 됩니다. (앱의 모든 광고 위치에 같은 ID 재사용)
NEXT_PUBLIC_GOOGLE_ADSENSE_SLOT=1234567890

# 슬롯별 개별 광고 단위 (선택 — 미설정 시 위 SLOT 값 사용)
# NEXT_PUBLIC_AD_SLOT_HOME_TOP=
# NEXT_PUBLIC_AD_SLOT_HOME_BOTTOM=
# ...

# ads.txt용 (선택 — 미설정 시 CLIENT에서 pub- ID 자동 추출)
# GOOGLE_ADSENSE_PUBLISHER_ID=pub-XXXXXXXXXXXXXXXX

# 광고 비활성화 (로컬 테스트)
# NEXT_PUBLIC_ADS_ENABLED=false
