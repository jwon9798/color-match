# Google AdSense (기본값이 코드에 설정됨 — Vercel에서 덮어쓰려면 env 사용)
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT=ca-pub-4911271163170466
GOOGLE_ADSENSE_PUBLISHER_ID=pub-4911271163170466

# 광고 단위 ID (AdSense에서 생성 후 입력 — 없으면 광고 칸만 비어 있음)
# NEXT_PUBLIC_GOOGLE_ADSENSE_SLOT=1234567890

# 광고 비활성화 (로컬 테스트)
# NEXT_PUBLIC_ADS_ENABLED=false

# AdSense 심사 필수 — 운영자 이메일 (문의·개인정보 처리방침에 표시)
NEXT_PUBLIC_CONTACT_EMAIL=your-email@example.com

# 사이트 URL (sitemap·OG 메타용)
NEXT_PUBLIC_SITE_URL=https://color-match-tan.vercel.app
